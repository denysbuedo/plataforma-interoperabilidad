{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.org/mes/event-envelope.json",
  "title": "Institutional event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "occurredAt", "source", "correlationId", "subject", "version", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": ["string", "null"], "format": "uuid" },
    "subject": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "data": { "type": "object" }
  }
}

