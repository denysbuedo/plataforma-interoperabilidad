ENVIRONMENT=integration
LOG_LEVEL=INFO
SERVICE_NAME=notification-service
OIDC_ISSUER_URL=https://identidad.reduniv.edu.cu/realms/interoperabilidad
OIDC_AUDIENCE=mes-api
OIDC_SWAGGER_CLIENT_ID=api-swagger
OIDC_PUBLIC_KEY_FILE=/etc/mes/oidc-rs256-public.pem
SMTP_HOST=[IP_INTERNA]
SMTP_PORT=25
SMTP_TLS_SERVER_NAME=correo.mes.gob.cu
SMTP_STARTTLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=replace-through-secure-channel
SMTP_PASSWORD=replace-through-secure-channel
EMAIL_FROM=replace-with-approved-sender
SMTP_TIMEOUT_SECONDS=10
