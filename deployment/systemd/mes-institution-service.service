[Unit]
Description=MES Institution Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mes-institutions
Group=mes-institutions
WorkingDirectory=/opt/mes/platform
EnvironmentFile=/etc/mes/institution-service.env
ExecStart=/opt/mes/platform/.venv/bin/uvicorn mes_institution_service.main:app --host [IP_INTERNA] --port 8002 --workers 2 --no-access-log
Restart=always
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mes/institution-service

[Install]
WantedBy=multi-user.target
